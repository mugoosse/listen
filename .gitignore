.build/
.xcbuild/
# Not all of .swiftpm: the shared scheme has to be tracked. xcodebuild
# generates schemes on demand, but only when it can write them, and on a clean
# CI checkout it cannot, so the build fails with "does not contain a scheme
# named listen". Committing it makes the scheme deterministic everywhere.
.swiftpm/configuration/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
Listen.app/
listen.app/
*.log
.DS_Store
dist/
.notarization

# A Sparkle private key exported for backup. It belongs in a password manager
# and nowhere else; this is a backstop for the minutes between writing it and
# deleting it, not somewhere to leave it. The public half is in sparkle.conf
# and is meant to be committed.
sparkle_private_key.txt

# local test helpers, not part of the app
scratch-*
