<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Every outbound connection Listen can make, declared so a firewall such as
  Little Snitch can show the user what each one is for and what blocking it
  costs. Listen's claim is that your meetings never leave the machine; that claim
  is only worth anything if the connections it does make are stated plainly.

  Transcription itself is absent from this list on purpose. It has no network
  path at all: the model runs locally and audio is never sent anywhere.
-->
<plist version="1.0">
<dict>
    <key>ApplicationDescription</key>
    <string>Records, transcribes and dictates entirely on your Mac.</string>
    <key>Connections</key>
    <array>
        <dict>
            <key>IsIncoming</key>
            <false/>
            <key>Host</key>
            <string>github.com</string>
            <key>NetworkProtocol</key>
            <string>TCP</string>
            <key>Port</key>
            <string>443</string>
            <key>Purpose</key>
            <string>Listen checks for new versions every two days.</string>
            <key>DenyConsequences</key>
            <string>You will not be told when a new version is released. Everything else keeps working.</string>
        </dict>
        <dict>
            <key>IsIncoming</key>
            <false/>
            <key>Host</key>
            <string>huggingface.co</string>
            <key>NetworkProtocol</key>
            <string>TCP</string>
            <key>Port</key>
            <string>443</string>
            <key>Purpose</key>
            <string>Downloading the Parakeet speech model you selected, once, about 2.4 GB. No audio is ever uploaded.</string>
            <key>DenyConsequences</key>
            <string>The Parakeet engines cannot be downloaded. The Apple Intelligence engine needs no download and still works.</string>
        </dict>
        <dict>
            <key>IsIncoming</key>
            <false/>
            <key>Host</key>
            <string>cdn-lfs.huggingface.co</string>
            <key>NetworkProtocol</key>
            <string>TCP</string>
            <key>Port</key>
            <string>443</string>
            <key>Purpose</key>
            <string>The CDN that actually serves the model weights.</string>
            <key>DenyConsequences</key>
            <string>The model download stalls partway through.</string>
        </dict>
        <!--
          The one connection this file cannot name a host for, because you
          choose it: Settings › Agent takes an OpenAI-compatible base URL, and
          Listen talks to whatever is there when you ask a question about your
          recordings.

          Left in as a wildcard rather than omitted. An undeclared connection is
          exactly what this file exists to rule out, and "Listen may talk to a
          server you nominated" is a true and useful thing for a firewall to be
          able to show you.

          If that URL is on this Mac, which is the default and what Ollama gives
          you, no outbound connection happens at all: it is loopback, and the
          claim that your meetings never leave the machine is untouched.
        -->
        <dict>
            <key>IsIncoming</key>
            <false/>
            <key>Host</key>
            <string>*</string>
            <key>NetworkProtocol</key>
            <string>TCP</string>
            <key>Purpose</key>
            <string>The OpenAI-compatible endpoint you set in Settings › Agent, if you set one. Only the meetings you ask about are sent, only at the moment you ask, and only when that endpoint is not on this Mac. There is no default and nothing is configured out of the box.</string>
            <key>DenyConsequences</key>
            <string>Questions put to a hosted endpoint fail. An endpoint running on this Mac, and Claude Code and Codex, are unaffected.</string>
        </dict>
    </array>
</dict>
</plist>
